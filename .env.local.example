# ── Copy this file to .env.local and fill in your values ────────────────────
# Then run: npm run dev

NODE_ENV=development
PORT=3000

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── CORS (leave empty for same-origin in dev) ────────────────────────────────
ALLOWED_ORIGINS=

# ── Open Library ──────────────────────────────────────────────────────────────
OPEN_LIBRARY_USER_AGENT=StoryPals/1.0 (children's reading app; your@email.com)

# ── Book import ───────────────────────────────────────────────────────────────
BOOK_IMPORT_ENABLED=false
BOOK_IMPORT_ADMIN_KEY=
