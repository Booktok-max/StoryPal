# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=

# ── Authentication ────────────────────────────────────────────────────────────
AUTH_PROVIDER=
AUTH_SECRET=

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Public base URL used to build password-reset and email-verification links.
# In production, set to your actual deployed domain, e.g. https://storypals.app
APP_URL=http://localhost:3000

# ── Transactional email (password reset, sign-up verification) ────────────────
# If unset, links are only console-logged server-side — nothing is sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=StoryPals <no-reply@storypals.app>

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=***

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS.
# In production, set this to your actual domain(s), e.g.:
# ALLOWED_ORIGINS=https://storypals.app,https://www.storypals.app
# Leave empty for same-origin only (recommended for same-host deploys).
ALLOWED_ORIGINS=

# ── Open Library ──────────────────────────────────────────────────────────────
# Sent as the User-Agent header on Open Library API requests.
# Required: Open Library asks applications to identify themselves.
OPEN_LIBRARY_USER_AGENT=StoryPals/1.0 (children's reading app; contact@yourdomain.com)

# ── Book import (Phase 3) ─────────────────────────────────────────────────────
# Set BOOK_IMPORT_ENABLED=true to enable POST /api/books/import
# BOOK_IMPORT_ADMIN_KEY must be set to a strong random secret when enabled.
# Generate one with: openssl rand -hex 32
BOOK_IMPORT_ENABLED=false
BOOK_IMPORT_ADMIN_KEY=

# ── Admin UI ─────────────────────────────────────────────────────────────────
# Set VITE_ADMIN_MODE=true to show approve/reject buttons on pending-review books.
# VITE_ADMIN_KEY must match BOOK_IMPORT_ADMIN_KEY on the server.
VITE_ADMIN_MODE=false
VITE_ADMIN_KEY=

# ── Object Storage ───────────────────────────────────────────────────────────
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# ── Google Books ──────────────────────────────────────────────────────────────
GOOGLE_BOOKS_API_KEY=

# ── NYT Books API (Sprint H.1, bestseller rail) ────────────────────────────────
# Free self-serve key from developer.nytimes.com.
NYT_API_KEY=

# ── Object storage (Sprint C.B) ────────────────────────────────────────────────
# Any S3-compatible endpoint works — Cloudflare R2 and Railway's object
# storage both speak the S3 API. Used for story illustrations today;
# uploaded EPUB/PDF files (Sprint D) will reuse this same client.
# Leave unset and illustration persistence just no-ops (warns, doesn't error).
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Public base URL to serve objects from — an R2 public bucket URL, a CDN
# domain in front of the bucket, etc.
STORAGE_PUBLIC_URL=

# ── ChildrenBooks API ────────────────────────────────────────────────────────
CHILDRENBOOKS_API_KEY=

# ── Seed script ───────────────────────────────────────────────────────────────
# Target server URL for scripts/seed-classics.ts (default: http://localhost:3000)
# SERVER_URL=http://localhost:3000
